# PRAGATI AI - Streamlit Community Cloud Secrets Template
# Copy these fields into Streamlit Cloud -> App Settings -> Secrets

SNOWFLAKE_ACCOUNT = "your_account"
SNOWFLAKE_USER = "your_username"
SNOWFLAKE_PASSWORD = "your_password"
SNOWFLAKE_WAREHOUSE = "PRAGATI_WH"
SNOWFLAKE_DATABASE = "PRAGATI_AI_DB"
SNOWFLAKE_SCHEMA = "CLEAN_DATA"
